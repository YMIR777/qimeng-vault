import { useMemo, useState, useEffect, useRef } from 'react';
import { useLedger } from '../store/useLedger';
import { useWishes } from '../store/useWishes';
import {
  LineChart, Line, XAxis, YAxis, CartesianGrid, Tooltip, ResponsiveContainer,
  PieChart, Pie, Cell,
} from 'recharts';
import gsap from 'gsap';

const spring = 'cubic-bezier(0.34, 1.56, 0.64, 1)';
const COLORS = ['#6b9fcf', '#c9923a', '#7a9e7e', '#b8af9e', '#d4a843'];

// ── 工具函数 ────────────────────────────────────────────────────
function fmtDate(ts: number): string {
  const d = new Date(ts);
  return `${d.getMonth() + 1}/${d.getDate()}`;
}
function fmtDuration(min: number): string {
  if (!min) return '0分钟';
  const h = Math.floor(min / 60);
  const m = min % 60;
  if (h > 0 && m > 0) return `${h}小时${m}分钟`;
  if (h > 0) return `${h}小时`;
  return `${m}分钟`;
}

// ── 数字滚动组件 ────────────────────────────────────────────────
function AnimatedNumber({ value, prefix = '', suffix = '', duration = 1.2, delay = 0 }: {
  value: number;
  prefix?: string;
  suffix?: string;
  duration?: number;
  delay?: number;
}) {
  const ref = useRef<HTMLSpanElement>(null);
  const [display, setDisplay] = useState(0);

  useEffect(() => {
    const el = ref.current;
    if (!el) return;
    const obj = { val: 0 };
    gsap.to(obj, {
      val: value,
      duration,
      delay,
      ease: 'power2.out',
      onUpdate: () => setDisplay(Math.round(obj.val)),
    });
  }, [value, duration, delay]);

  return (
    <span ref={ref}>
      {prefix}{display.toLocaleString()}{suffix}
    </span>
  );
}

// ── 共用样式 token ───────────────────────────────────────────────
const css = {
  bg: '#f5f0e8',
  card: '#f0ebe0',
  cardInset: '#e8e3d9',
  text: '#3d3427',
  textMuted: '#a89f8e',
  blue: '#6b9fcf',
  gold: '#c9923a',
  shadow: '5px 5px 12px #cdc5b8, -5px -5px 12px #fffbf5',
  shadowSm: '3px 3px 8px #cdc5b8, -3px -3px 8px #fffbf5',
  shadowInset: 'inset 2px 2px 4px #cdc5b8, inset -2px -2px 4px #fffbf5',
  label: {
    fontFamily: "'Noto Sans SC', sans-serif",
    fontSize: '10px',
    letterSpacing: '0.3em',
    color: '#a89f8e',
    textTransform: 'uppercase' as const,
  },
};

// ── Card 包装 ────────────────────────────────────────────────────
function Card({ children, style = {}, className = '' }: { children: React.ReactNode; style?: React.CSSProperties; className?: string }) {
  return (
    <div
      className={className}
      style={{
        background: css.card,
        borderRadius: '20px',
        padding: '24px',
        boxShadow: css.shadow,
        ...style,
      }}
    >
      {children}
    </div>
  );
}

// ── Section Label ────────────────────────────────────────────────
function SectionLabel({ children }: { children: React.ReactNode }) {
  return (
    <div style={{ ...css.label, marginBottom: '16px' }}>{children}</div>
  );
}

export function Workbench() {
  const { transactions } = useLedger();
  const { wishes } = useWishes();
  const [activePeriod, setActivePeriod] = useState<'all' | 'month' | 'week'>('all');
  const pageRef = useRef<HTMLDivElement>(null);

  const filteredTx = useMemo(() => {
    if (activePeriod === 'all') return transactions;
    const now = Date.now();
    const ms = activePeriod === 'month' ? 30 * 24 * 60 * 60 * 1000 : 7 * 24 * 60 * 60 * 1000;
    return transactions.filter(t => t.date >= now - ms);
  }, [transactions, activePeriod]);

  const incomeTx = filteredTx.filter(t => t.type === 'income');
  const expenseTx = filteredTx.filter(t => t.type === 'expense');

  // ── 页面入场动画 ──────────────────────────────────────────────
  useEffect(() => {
    if (!pageRef.current) return;
    const sections = pageRef.current.querySelectorAll('.wb-section');
    gsap.fromTo(sections,
      { y: 40, opacity: 0 },
      { y: 0, opacity: 1, duration: 0.7, stagger: 0.1, ease: 'power2.out', delay: 0.15 }
    );
  }, []);

  // ── 本周概览 ──────────────────────────────────────────────────
  const weekComparison = useMemo(() => {
    const now = new Date();
    const thisWeekStart = new Date(now);
    thisWeekStart.setDate(now.getDate() - now.getDay());
    thisWeekStart.setHours(0, 0, 0, 0);

    const lastWeekStart = new Date(thisWeekStart);
    lastWeekStart.setDate(thisWeekStart.getDate() - 7);
    const lastWeekEnd = new Date(thisWeekStart);
    lastWeekEnd.setDate(thisWeekStart.getDate() - 1);
    lastWeekEnd.setHours(23, 59, 59, 999);

    const thisWeekTx = transactions.filter(t => t.date >= thisWeekStart.getTime());
    const lastWeekTx = transactions.filter(t => t.date >= lastWeekStart.getTime() && t.date <= lastWeekEnd.getTime());

    const sum = (txs: typeof transactions) => ({
      income: txs.filter(t => t.type === 'income').reduce((s, t) => s + t.amount, 0),
      expense: txs.filter(t => t.type === 'expense').reduce((s, t) => s + t.amount, 0),
      minutes: txs.filter(t => t.type === 'income' && t.timeSpent).reduce((s, t) => s + (t.timeSpent ?? 0), 0),
    });

    const thisS = sum(thisWeekTx);
    const lastS = sum(lastWeekTx);

    return {
      thisWeek: { ...thisS, net: thisS.income - thisS.expense },
      lastWeek: { ...lastS, net: lastS.income - lastS.expense },
      incomeChange: lastS.income > 0 ? ((thisS.income - lastS.income) / lastS.income) * 100 : 0,
    };
  }, [transactions]);

  // ── 工作时长统计 ──────────────────────────────────────────────
  const timeStats = useMemo(() => {
    const txWithTime = incomeTx.filter(t => t.timeSpent && t.timeSpent > 0);
    const totalMin = txWithTime.reduce((s, t) => s + (t.timeSpent ?? 0), 0);
    const totalIncome = txWithTime.reduce((s, t) => s + t.amount, 0);
    const avgMin = txWithTime.length > 0 ? Math.round(totalMin / txWithTime.length) : 0;
    const hourlyRate = totalMin > 0 ? Math.round(totalIncome / (totalMin / 60)) : 0;

    let bestRate = 0;
    let bestTx: typeof txWithTime[0] | null = null;
    for (const tx of txWithTime) {
      const rate = tx.amount / ((tx.timeSpent ?? 1) / 60);
      if (rate > bestRate) { bestRate = rate; bestTx = tx; }
    }

    return { totalMin, avgMin, hourlyRate, bestRate: Math.round(bestRate), bestTx };
  }, [incomeTx]);

  // ── 时薪趋势 ──────────────────────────────────────────────────
  const rateData = useMemo(() => {
    const txWithTime = filteredTx.filter(t => t.type === 'income' && t.timeSpent && t.timeSpent > 0);
    if (txWithTime.length === 0) return [];

    const byWeek: Record<string, { income: number; minutes: number }> = {};
    for (const tx of txWithTime) {
      const d = new Date(tx.date);
      const weekStart = new Date(d);
      weekStart.setDate(d.getDate() - d.getDay());
      const key = fmtDate(weekStart.getTime());
      if (!byWeek[key]) byWeek[key] = { income: 0, minutes: 0 };
      byWeek[key].income += tx.amount;
      byWeek[key].minutes += tx.timeSpent ?? 0;
    }

    return Object.entries(byWeek)
      .map(([week, data]) => ({
        week,
        rate: Math.round(data.income / (data.minutes / 60)),
        income: data.income,
        hours: +(data.minutes / 60).toFixed(1),
      }))
      .sort((a, b) => a.week.localeCompare(b.week))
      .slice(-8);
  }, [filteredTx]);

  // ── 来源分布 ──────────────────────────────────────────────────
  const pieData = useMemo(() => {
    const byPlatform: Record<string, number> = {};
    for (const tx of incomeTx) {
      const p = tx.platform || '其他';
      byPlatform[p] = (byPlatform[p] || 0) + tx.amount;
    }
    return Object.entries(byPlatform)
      .map(([name, value]) => ({ name, value }))
      .sort((a, b) => b.value - a.value);
  }, [incomeTx]);

  // ── 老板分析 ───────────────────────────────────────────────────
  const bossAnalysis = useMemo(() => {
    const bosses: Record<string, { income: number; count: number; minutes: number }> = {};
    for (const tx of incomeTx) {
      if (!tx.bossName) continue;
      if (!bosses[tx.bossName]) bosses[tx.bossName] = { income: 0, count: 0, minutes: 0 };
      bosses[tx.bossName].income += tx.amount;
      bosses[tx.bossName].count += 1;
      bosses[tx.bossName].minutes += tx.timeSpent ?? 0;
    }
    return Object.entries(bosses)
      .map(([name, data]) => ({
        name,
        ...data,
        avg: Math.round(data.income / data.count),
        rate: data.minutes > 0 ? Math.round(data.income / (data.minutes / 60)) : 0,
      }))
      .sort((a, b) => b.income - a.income);
  }, [incomeTx]);

  // ── 热力图 ────────────────────────────────────────────────────
  const heatmap = useMemo(() => {
    const days: { date: string; income: number; expense: number; net: number; isToday: boolean }[] = [];
    const today = new Date();
    today.setHours(0, 0, 0, 0);
    for (let i = 6; i >= 0; i--) {
      const d = new Date(today);
      d.setDate(d.getDate() - i);
      const start = d.getTime();
      const end = start + 24 * 60 * 60 * 1000;
      const dayTx = transactions.filter(t => t.date >= start && t.date < end);
      const income = dayTx.filter(t => t.type === 'income').reduce((s, t) => s + t.amount, 0);
      const expense = dayTx.filter(t => t.type === 'expense').reduce((s, t) => s + t.amount, 0);
      days.push({
        date: `${d.getMonth() + 1}/${d.getDate()}`,
        income,
        expense,
        net: income - expense,
        isToday: i === 0,
      });
    }
    return days;
  }, [transactions]);

  const heatmapRefs = useRef<(HTMLDivElement | null)[]>([]);
  useEffect(() => {
    const els = heatmapRefs.current.filter(Boolean);
    if (els.length === 0) return;
    gsap.fromTo(els,
      { scale: 0.6, opacity: 0, y: 20 },
      { scale: 1, opacity: 1, y: 0, duration: 0.5, stagger: 0.08, ease: 'back.out(1.7)', delay: 0.4 }
    );
    const todayEl = els[els.length - 1];
    if (todayEl) {
      gsap.to(todayEl, {
        scale: 1.05,
        duration: 1.5,
        yoyo: true,
        repeat: -1,
        ease: 'sine.inOut',
        delay: 1,
      });
    }
  }, [heatmap]);

  const bossRefs = useRef<(HTMLDivElement | null)[]>([]);
  useEffect(() => {
    const els = bossRefs.current.filter(Boolean);
    if (els.length === 0) return;
    gsap.fromTo(els,
      { x: -30, opacity: 0 },
      { x: 0, opacity: 1, duration: 0.5, stagger: 0.1, ease: 'power2.out', delay: 0.5 }
    );
  }, [bossAnalysis]);

  const progressRef = useRef<HTMLDivElement>(null);
  const totalIncome = incomeTx.reduce((s, t) => s + t.amount, 0);
  const totalExpense = expenseTx.reduce((s, t) => s + t.amount, 0);
  const net = totalIncome - totalExpense;
  const avgIncome = incomeTx.length > 0 ? Math.round(totalIncome / incomeTx.length) : 0;

  const activeWishes = wishes.filter(w => w.status === 'building');
  const closestWish = activeWishes.length > 0
    ? activeWishes.sort((a, b) => (a.currentBalance / a.targetPrice) - (b.currentBalance / b.targetPrice)).pop()
    : null;

  useEffect(() => {
    if (!progressRef.current || !closestWish) return;
    const pct = Math.min((closestWish.currentBalance / closestWish.targetPrice) * 100, 100);
    gsap.fromTo(progressRef.current,
      { width: '0%' },
      { width: `${pct}%`, duration: 1.2, ease: 'elastic.out(1, 0.5)', delay: 0.8 }
    );
  }, [closestWish]);

  // ── 布局样式 (注入 head) ──────────────────────────────────────
  useEffect(() => {
    const styleId = 'wb-dashboard-styles';
    if (document.getElementById(styleId)) return;
    const style = document.createElement('style');
    style.id = styleId;
    style.textContent = `
      @media (min-width: 900px) {
        .wb-grid {
          display: grid !important;
          grid-template-columns: repeat(12, 1fr) !important;
          grid-template-rows: auto !important;
          gap: 20px !important;
        }
        .wb-header { grid-column: 1 / 13 !important; }
        .wb-hero   { grid-column: 1 / 8 !important; grid-row: span 1 !important; }
        .wb-timests { grid-column: 8 / 13 !important; }
        .wb-heatmap { grid-column: 1 / 13 !important; }
        .wb-trend   { grid-column: 1 / 8 !important; }
        .wb-source  { grid-column: 8 / 13 !important; }
        .wb-boss    { grid-column: 1 / 13 !important; }
        .wb-wish    { grid-column: 1 / 13 !important; }
      }
      @media (max-width: 899px) {
        .wb-grid { gap: 16px !important; }
        .wb-hero, .wb-timests, .wb-heatmap,
        .wb-trend, .wb-source, .wb-boss, .wb-wish {
          grid-column: 1 / 2 !important;
        }
      }
    `;
    document.head.appendChild(style);
    return () => {
      const el = document.getElementById(styleId);
      if (el) el.remove();
    };
  }, []);

  // ── 渲染 ─────────────────────────────────────────────────────
  return (
    <div
      ref={pageRef}
      style={{
        minHeight: '100dvh',
        background: css.bg,
        padding: '32px 24px 110px',
      }}
    >
      {/* 全宽容器 */}
      <div style={{ maxWidth: '1200px', margin: '0 auto' }}>

        {/* ── Header ─────────────────────────────────────────── */}
        <div
          className="wb-section wb-header"
          style={{
            display: 'flex',
            justifyContent: 'space-between',
            alignItems: 'flex-end',
            marginBottom: '24px',
            // Desktop: already full-width via grid
          }}
        >
          <div>
            <div style={{
              fontFamily: "'Noto Serif SC', serif",
              fontSize: '11px',
              letterSpacing: '0.5em',
              color: '#b8af9e',
              textTransform: 'uppercase',
              marginBottom: '2px',
            }}>绮梦账间</div>
            <h1 style={{
              fontFamily: "'Noto Sans SC', sans-serif",
              fontSize: '24px',
              fontWeight: 500,
              color: css.text,
              letterSpacing: '-0.01em',
              margin: 0,
            }}>工作台</h1>
          </div>
          {/* 周期切换 */}
          <div style={{
            display: 'flex',
            gap: '4px',
            background: css.card,
            borderRadius: '12px',
            padding: '4px',
            boxShadow: css.shadowInset,
          }}>
            {(['all', 'month', 'week'] as const).map(p => (
              <button
                key={p}
                onClick={() => setActivePeriod(p)}
                style={{
                  padding: '7px 16px',
                  borderRadius: '10px',
                  border: 'none',
                  background: activePeriod === p ? css.card : 'transparent',
                  boxShadow: activePeriod === p ? css.shadowSm : 'none',
                  color: activePeriod === p ? css.text : css.textMuted,
                  fontSize: '12px',
                  fontFamily: "'Noto Sans SC', sans-serif",
                  cursor: 'pointer',
                  transition: `all 0.25s ${spring}`,
                }}
              >
                {p === 'all' ? '全部' : p === 'month' ? '本月' : '本周'}
              </button>
            ))}
          </div>
        </div>

        {/* ── Bento Grid ─────────────────────────────────────── */}
        <div className="wb-grid" style={{ display: 'flex', flexDirection: 'column', gap: '20px' }}>

          {/* Row 1: 本周概览 (大) + 工作时长 (右) */}
          <div style={{ display: 'grid', gridTemplateColumns: 'repeat(12, 1fr)', gap: '20px' }}>
            {/* 本周概览 Hero — 左侧大卡 */}
            <div
              className="wb-section"
              style={{ gridColumn: 'span 7' }}
            >
              <Card style={{ height: '100%' }}>
                <SectionLabel>本周概览</SectionLabel>
                <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: '20px' }}>
                  <div>
                    <div style={{ fontSize: '11px', color: css.textMuted, marginBottom: '8px', letterSpacing: '0.1em' }}>本周收入</div>
                    <div style={{
                      fontFamily: "'Noto Serif SC', serif",
                      fontSize: '36px',
                      color: css.blue,
                      lineHeight: 1,
                    }}>
                      +<AnimatedNumber value={weekComparison.thisWeek.income} />
                    </div>
                    <div style={{ fontSize: '12px', color: css.textMuted, marginTop: '8px' }}>
                      净增 ¥{weekComparison.thisWeek.net.toLocaleString()}
                    </div>
                  </div>
                  <div>
                    <div style={{ fontSize: '11px', color: css.textMuted, marginBottom: '8px', letterSpacing: '0.1em' }}>上周收入</div>
                    <div style={{
                      fontFamily: "'Noto Serif SC', serif",
                      fontSize: '28px',
                      color: '#c5bdb0',
                      lineHeight: 1,
                    }}>
                      +<AnimatedNumber value={weekComparison.lastWeek.income} delay={0.15} />
                    </div>
                    <div style={{ fontSize: '12px', color: '#c5bdb0', marginTop: '8px' }}>
                      净增 ¥{weekComparison.lastWeek.net.toLocaleString()}
                    </div>
                  </div>
                </div>
                {/* 变化指示 */}
                <div style={{
                  marginTop: '20px',
                  padding: '12px 16px',
                  borderRadius: '12px',
                  background: weekComparison.incomeChange >= 0
                    ? 'rgba(107,159,207,0.08)'
                    : 'rgba(201,146,58,0.08)',
                  display: 'flex',
                  alignItems: 'center',
                  gap: '8px',
                }}>
                  <span style={{
                    fontSize: '18px',
                    color: weekComparison.incomeChange >= 0 ? css.blue : css.gold,
                  }}>
                    {weekComparison.incomeChange >= 0 ? '\u25B2' : '\u25BC'}
                  </span>
                  <span style={{
                    fontSize: '14px',
                    color: weekComparison.incomeChange >= 0 ? css.blue : css.gold,
                    fontFamily: "'Noto Serif SC', serif",
                  }}>
                    {Math.abs(weekComparison.incomeChange).toFixed(0)}%
                  </span>
                  <span style={{ fontSize: '12px', color: css.textMuted }}>对比上周</span>
                </div>
              </Card>
            </div>

            {/* 工作时长 — 右侧卡片 */}
            <div className="wb-section" style={{ gridColumn: 'span 5' }}>
              <Card style={{ height: '100%', display: 'flex', flexDirection: 'column' }}>
                <SectionLabel>工作时长</SectionLabel>
                {timeStats.totalMin === 0 ? (
                  <div style={{ textAlign: 'center', padding: '24px 0', color: '#c5bdb0', fontSize: '13px', flex: 1, display: 'flex', flexDirection: 'column', justifyContent: 'center' }}>
                    <div>暂无工时记录</div>
                    <div style={{ fontSize: '11px', marginTop: '6px', color: '#b8af9e' }}>记录收入时加上时间</div>
                  </div>
                ) : (
                  <>
                    <div style={{ display: 'grid', gridTemplateColumns: 'repeat(3, 1fr)', gap: '12px', marginBottom: '14px' }}>
                      <div style={{ textAlign: 'center' }}>
                        <div style={{ fontFamily: "'Noto Serif SC', serif", fontSize: '22px', color: css.text }}>
                          <AnimatedNumber value={timeStats.totalMin} suffix="" />
                        </div>
                        <div style={{ fontSize: '9px', color: css.textMuted, marginTop: '4px' }}>总时长(分)</div>
                      </div>
                      <div style={{ textAlign: 'center' }}>
                        <div style={{ fontFamily: "'Noto Serif SC', serif", fontSize: '22px', color: css.text }}>
                          <AnimatedNumber value={timeStats.avgMin} suffix="" delay={0.1} />
                        </div>
                        <div style={{ fontSize: '9px', color: css.textMuted, marginTop: '4px' }}>平均(分)</div>
                      </div>
                      <div style={{ textAlign: 'center' }}>
                        <div style={{ fontFamily: "'Noto Serif SC', serif", fontSize: '22px', color: css.blue }}>
                          <AnimatedNumber value={timeStats.hourlyRate} suffix="" delay={0.2} />
                        </div>
                        <div style={{ fontSize: '9px', color: css.textMuted, marginTop: '4px' }}>时薪</div>
                      </div>
                    </div>
                    {timeStats.bestTx && (
                      <div style={{
                        marginTop: 'auto',
                        padding: '10px 14px',
                        background: 'rgba(107,159,207,0.08)',
                        borderRadius: '10px',
                        fontSize: '11px',
                        color: css.blue,
                      }}>
                        最高 ¥{timeStats.bestRate}/h · {timeStats.bestTx.platform} · {fmtDate(timeStats.bestTx.date)}
                      </div>
                    )}
                  </>
                )}
              </Card>
            </div>
          </div>

          {/* Row 2: 热力图 (全宽) */}
          <div className="wb-section wb-heatmap">
            <Card>
              <SectionLabel>近7天收支</SectionLabel>
              <div style={{ display: 'flex', gap: '8px' }}>
                {heatmap.map((day, i) => {
                  const maxNet = Math.max(...heatmap.map(d => Math.abs(d.net))) || 1;
                  const intensity = Math.min(Math.abs(day.net) / maxNet, 1);
                  const isPositive = day.net >= 0;
                  return (
                    <div key={i} style={{ flex: 1, textAlign: 'center' }}>
                      <div
                        ref={el => { heatmapRefs.current[i] = el; }}
                        style={{
                          aspectRatio: '1',
                          borderRadius: '14px',
                          background: day.net === 0
                            ? '#e8e1d5'
                            : isPositive
                              ? `rgba(107,159,207,${0.12 + intensity * 0.6})`
                              : `rgba(201,146,58,${0.12 + intensity * 0.6})`,
                          display: 'flex',
                          alignItems: 'center',
                          justifyContent: 'center',
                          fontSize: '11px',
                          color: day.net === 0 ? '#c5bdb0' : isPositive ? '#4a7aad' : '#a07030',
                          fontFamily: "'Noto Serif SC', serif",
                          marginBottom: '8px',
                          transition: 'transform 0.2s',
                        }}
                      >
                        {day.net !== 0 ? (day.net > 0 ? '+' : '') + day.net : '\u00B7'}
                      </div>
                      <div style={{
                        fontSize: '10px',
                        color: day.isToday ? css.gold : css.textMuted,
                        fontWeight: day.isToday ? 600 : 400,
                      }}>{day.date}</div>
                    </div>
                  );
                })}
              </div>
            </Card>
          </div>

          {/* Row 3: 时薪趋势 (左7) + 来源分布+统计 (右5) */}
          <div style={{ display: 'grid', gridTemplateColumns: 'repeat(12, 1fr)', gap: '20px' }}>
            <div className="wb-section wb-trend" style={{ gridColumn: 'span 7' }}>
              <Card style={{ height: '100%', minHeight: '280px' }}>
                <SectionLabel>时薪趋势</SectionLabel>
                {rateData.length === 0 ? (
                  <div style={{ textAlign: 'center', padding: '48px 0', color: '#c5bdb0', fontSize: '13px' }}>
                    暂无工时记录
                  </div>
                ) : (
                  <div style={{ width: '100%', height: '220px' }}>
                    <ResponsiveContainer width="100%" height="100%">
                      <LineChart data={rateData} margin={{ top: 5, right: 10, left: -16, bottom: 0 }}>
                        <CartesianGrid strokeDasharray="3 3" stroke="#e8e1d5" />
                        <XAxis dataKey="week" tick={{ fontSize: 10, fill: '#a89f8e' }} axisLine={{ stroke: '#e8e1d5' }} tickLine={false} />
                        <YAxis tick={{ fontSize: 10, fill: '#a89f8e' }} axisLine={false} tickLine={false} unit="/h" />
                        <Tooltip
                          contentStyle={{
                            background: '#f0ebe0', border: 'none', borderRadius: '12px',
                            boxShadow: '4px 4px 12px #cdc5b8', fontSize: '12px', color: '#3d3427',
                          }}
                          formatter={(value: any) => [`¥${value}/h`, '时薪']}
                        />
                        <Line type="monotone" dataKey="rate" stroke="#6b9fcf" strokeWidth={2.5}
                          dot={{ fill: '#6b9fcf', strokeWidth: 0, r: 4 }}
                          activeDot={{ fill: '#c9923a', r: 6, strokeWidth: 0 }}
                        />
                      </LineChart>
                    </ResponsiveContainer>
                  </div>
                )}
              </Card>
            </div>

            <div className="wb-section wb-source" style={{ gridColumn: 'span 5' }}>
              <Card style={{ height: '100%' }}>
                <SectionLabel>来源分布</SectionLabel>
                {pieData.length === 0 ? (
                  <div style={{ textAlign: 'center', padding: '32px 0', color: '#c5bdb0', fontSize: '13px' }}>
                    暂无收入记录
                  </div>
                ) : (
                  <div style={{ display: 'flex', flexDirection: 'column', gap: '12px' }}>
                    <div style={{ height: '160px' }}>
                      <ResponsiveContainer width="100%" height="100%">
                        <PieChart>
                          <Pie data={pieData} cx="50%" cy="50%" innerRadius={40} outerRadius={65} paddingAngle={4} dataKey="value" stroke="none">
                            {pieData.map((entry, index) => (
                              <Cell key={entry.name} fill={COLORS[index % COLORS.length]} />
                            ))}
                          </Pie>
                          <Tooltip
                            contentStyle={{
                              background: '#f0ebe0', border: 'none', borderRadius: '12px',
                              boxShadow: '4px 4px 12px #cdc5b8', fontSize: '12px', color: '#3d3427',
                            }}
                            formatter={(value: any, name: any) => [`¥${Number(value).toLocaleString()}`, name]}
                          />
                        </PieChart>
                      </ResponsiveContainer>
                    </div>
                    {/* 图例 + 统计 */}
                    <div style={{ display: 'flex', gap: '6px', flexWrap: 'wrap', justifyContent: 'center' }}>
                      {pieData.slice(0, 4).map((entry, index) => (
                        <div key={entry.name} style={{ display: 'flex', alignItems: 'center', gap: '4px' }}>
                          <div style={{ width: '7px', height: '7px', borderRadius: '50%', background: COLORS[index % COLORS.length] }} />
                          <span style={{ fontSize: '10px', color: css.textMuted }}>{entry.name}</span>
                        </div>
                      ))}
                    </div>
                    {/* 快速统计 */}
                    <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr 1fr', gap: '8px', marginTop: '4px' }}>
                      <div style={{ textAlign: 'center', background: '#ece7dc', borderRadius: '10px', padding: '10px 6px' }}>
                        <div style={{ fontFamily: "'Noto Serif SC', serif", fontSize: '15px', color: css.blue }}>
                          <AnimatedNumber value={avgIncome} />
                        </div>
                        <div style={{ fontSize: '9px', color: css.textMuted, marginTop: '2px' }}>平均单笔</div>
                      </div>
                      <div style={{ textAlign: 'center', background: '#ece7dc', borderRadius: '10px', padding: '10px 6px' }}>
                        <div style={{ fontFamily: "'Noto Serif SC', serif", fontSize: '15px', color: css.blue }}>
                          <AnimatedNumber value={bossAnalysis.length} delay={0.1} />
                        </div>
                        <div style={{ fontSize: '9px', color: css.textMuted, marginTop: '2px' }}>回头老板</div>
                      </div>
                      <div style={{ textAlign: 'center', background: '#ece7dc', borderRadius: '10px', padding: '10px 6px' }}>
                        <div style={{ fontFamily: "'Noto Serif SC', serif", fontSize: '15px', color: net >= 0 ? css.blue : css.gold }}>
                          <AnimatedNumber value={Math.abs(net)} delay={0.2} />
                        </div>
                        <div style={{ fontSize: '9px', color: css.textMuted, marginTop: '2px' }}>
                          {net >= 0 ? '净盈余' : '净亏损'}
                        </div>
                      </div>
                    </div>
                  </div>
                </Card>
              </div>
            </div>

            {/* Row 4: 老板分析 (全宽) */}
            {bossAnalysis.length > 0 && (
              <div className="wb-section wb-boss" style={{ gridColumn: 'span 12' }}>
                <Card>
                  <SectionLabel>老板分析</SectionLabel>
                  <div style={{ display: 'flex', flexDirection: 'column', gap: '10px' }}>
                    {bossAnalysis.map((boss, i) => (
                      <div
                        key={boss.name}
                        ref={el => { bossRefs.current[i] = el; }}
                        style={{
                          display: 'flex',
                          alignItems: 'center',
                          justifyContent: 'space-between',
                          padding: '14px 18px',
                          background: '#ece7dc',
                          borderRadius: '14px',
                          boxShadow: css.shadowInset,
                          transition: `transform 0.2s ${spring}`,
                        }}
                        onMouseEnter={e => (e.currentTarget.style.transform = 'scale(1.01)')}
                        onMouseLeave={e => (e.currentTarget.style.transform = 'scale(1)')}
                      >
                        <div style={{ display: 'flex', alignItems: 'center', gap: '14px' }}>
                          <div style={{
                            width: '40px',
                            height: '40px',
                            borderRadius: '50%',
                            background: 'rgba(107,159,207,0.12)',
                            display: 'flex',
                            alignItems: 'center',
                            justifyContent: 'center',
                            fontSize: '14px',
                            color: css.blue,
                            fontFamily: "'Noto Serif SC', serif",
                            flexShrink: 0,
                          }}>
                            {boss.name.charAt(0)}
                          </div>
                          <div>
                            <div style={{ fontSize: '14px', color: css.text, fontWeight: 500 }}>{boss.name}</div>
                            <div style={{ fontSize: '11px', color: css.textMuted, marginTop: '2px' }}>
                              {boss.count}次 · 平均¥{boss.avg.toLocaleString()}
                            </div>
                          </div>
                        </div>
                        <div style={{ textAlign: 'right', flexShrink: 0 }}>
                          <div style={{ fontSize: '16px', color: css.blue, fontFamily: "'Noto Serif SC', serif" }}>
                            ¥{boss.income.toLocaleString()}
                          </div>
                          {boss.rate > 0 && (
                            <div style={{ fontSize: '10px', color: '#b8af9e', marginTop: '2px' }}>
                              ¥{boss.rate}/h
                            </div>
                          )}
                        </div>
                      </div>
                    ))}
                  </div>
                </Card>
              </div>
            )}

            {/* Row 5: 星体进度 (全宽) */}
            {closestWish && (
              <div className="wb-section wb-wish" style={{ gridColumn: 'span 12' }}>
                <Card>
                  <SectionLabel>正在攒的星体</SectionLabel>
                  <div style={{ display: 'flex', alignItems: 'center', gap: '18px', marginBottom: '16px' }}>
                    <div style={{
                      width: '48px',
                      height: '48px',
                      borderRadius: '50%',
                      background: 'rgba(201,146,58,0.12)',
                      display: 'flex',
                      alignItems: 'center',
                      justifyContent: 'center',
                      fontSize: '20px',
                      flexShrink: 0,
                    }}>
                      {'\u2605'}
                    </div>
                    <div style={{ flex: 1 }}>
                      <div style={{ fontSize: '15px', color: css.text, fontWeight: 500 }}>{closestWish.name}</div>
                      <div style={{ fontSize: '12px', color: css.textMuted, marginTop: '3px' }}>
                        ¥{closestWish.currentBalance.toLocaleString()} / ¥{closestWish.targetPrice.toLocaleString()}
                      </div>
                    </div>
                    <div style={{
                      fontFamily: "'Noto Serif SC', serif",
                      fontSize: '20px',
                      color: css.gold,
                      flexShrink: 0,
                    }}>
                      <AnimatedNumber value={Math.round((closestWish.currentBalance / closestWish.targetPrice) * 100)} suffix="%" />
                    </div>
                  </div>
                  <div style={{
                    height: '8px',
                    borderRadius: '4px',
                    background: '#e0dbd3',
                    overflow: 'hidden',
                  }}>
                    <div ref={progressRef} style={{
                      height: '100%',
                      borderRadius: '4px',
                      background: `linear-gradient(90deg, ${css.gold}, #d4a843)`,
                      width: '0%',
                    }} />
                  </div>
                </Card>
              </div>
            )}

          </div>{/* end wb-grid */}
        </div>{/* end container */}
      </div>
    </div>
  );
}